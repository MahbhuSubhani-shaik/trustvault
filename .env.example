# Copy this file to .env and fill it in. Never commit .env.

# Signs the session cookie. Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use a different value on the deployed site.
SECRET_KEY=

# 1 turns on the Werkzeug debugger and auto-reload. Your own machine only:
# the debugger lets anyone who can reach it run code on the server.
FLASK_DEBUG=0

# Leave at 1 when the site is served over HTTPS (the deployed site).
# Set to 0 only for local development on http://127.0.0.1.
SESSION_COOKIE_SECURE=1
