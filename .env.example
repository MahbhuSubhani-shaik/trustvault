# Copy this file to .env and fill it in. Never commit .env.

# Signs the session cookie. Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use a different value on the deployed site.
SECRET_KEY=

# Signs the audit log's hash chain (HMAC-SHA256). Required, at least 32
# characters, generated the same way. Must differ from SECRET_KEY. If it
# changes, existing audit entries will no longer verify.
AUDIT_KEY=

# Optional. Defaults to instance/trustvault.sqlite3.
# DATABASE_PATH=

# 1 only when running behind a proxy that sets X-Forwarded-For (PythonAnywhere,
# Render), so the audit log records the visitor's real IP.
TRUST_PROXY=0

# Optional. Creates this admin account when the app starts, if it doesn't exist
# yet (for hosts with no shell, like Render's free plan). The password must
# follow the normal rules (12+ characters, not common). Never commit real values.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_EMAIL=

# 1 turns on the Werkzeug debugger and auto-reload. Your own machine only:
# the debugger lets anyone who can reach it run code on the server.
FLASK_DEBUG=0

# Leave at 1 when the site is served over HTTPS (the deployed site).
# Set to 0 only for local development on http://127.0.0.1.
SESSION_COOKIE_SECURE=1
